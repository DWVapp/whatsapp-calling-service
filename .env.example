PORT=19000
JWT_SECRET=your-shared-secret

# TURN server (REQUIRED when hosted on a platform without inbound UDP, e.g.
# Render). When TURN_USERNAME/TURN_CREDENTIAL are set, the service forces
# iceTransportPolicy=relay, so all media flows through the TURN relay.
STUN_URL=stun:stun.relay.metered.ca:80
# Single TURN URL...
TURN_URL=
# ...or multiple URLs sharing the same credentials (comma-separated). Prefer
# this so the :443 / turns: variants are available on restrictive networks.
TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=
